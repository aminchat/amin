# متغیرهای لازم — در پنل Vercel (Settings → Environment Variables) ست شوند، نه در کد.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# همان SEAL_KEY ورکر Cloudflare — برای مشترک‌بودن توکن‌های مهرشده بین دو میزبان
SEAL_KEY=
# اختیاری — پیش‌فرض کد همین است:
# ALLOWED_APP=https://taraz-app.github.io
# (خودکار توسط یکپارچه‌سازی Upstash اضافه می‌شود — برای قابلیت گروه‌ها در آینده)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
